<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground. The lock-V glyph sits inside
  the safe zone of the 108x108 adaptive canvas (66x66 center area)
  so launchers that mask the icon (round, squircle, teardrop) do
  not crop the body or the shackle. The body is crimson-on-crimson
  which the launcher theme may vary, so we render the body in
  paper and the shackle in crimson instead — same identity, just
  inverted so the silhouette pops on every launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Body in paper, shackle in crimson — silhouettes for adaptive icons -->
    <group android:translateX="21" android:translateY="21">
        <group android:scaleX="0.75" android:scaleY="0.75">
            <path
                android:fillColor="#F5F2EA"
                android:pathData="M 36 52 L 30 58 L 30 100 L 90 100 L 90 58 L 84 52 Z" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#9B1B1F"
                android:strokeWidth="7"
                android:strokeLineCap="square"
                android:strokeLineJoin="miter"
                android:pathData="M 42 52 L 42 30 L 60 48 L 78 30 L 78 52" />
            <path
                android:fillColor="#F2C70F"
                android:pathData="M 40 70 L 80 70 L 80 72.5 L 40 72.5 Z" />
            <path
                android:fillColor="#F2C70F"
                android:pathData="M 56 78 L 64 78 L 64 86 L 56 86 Z" />
        </group>
    </group>
</vector>
